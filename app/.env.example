# Copy to .env.local (git-ignored). Never commit real values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Leave empty to disable the human check client-side.
EXPO_PUBLIC_TURNSTILE_SITEKEY=

# Social sign-in buttons to show (web only). Comma list of: google, azure. Leave empty until the provider is set up in Supabase.
EXPO_PUBLIC_SOCIAL_PROVIDERS=

# Where emailed links (confirm email, reset password) and social sign-in return to. Leave empty in development:
# the app then uses the page's own address (http://localhost:8081). Production: https://health.carciente.ca
EXPO_PUBLIC_SITE_URL=
